// =============================================================================
//  插销 2 号 · 直插销  (Straight Peg, Ø6 hole / 16 mm pitch pegboard)
//  几何实测自「手电钻16mm.3mf」参考件：销身 Ø5.50 等径 + 卡环 Ø5.97 @ 3.95
//  + 球头收尾，轴长 8.01。剖面数据见 pegs/profile.json（0.05 mm 步长）
//  打印: 轴竖立(与本文件坐标一致)，球头朝上，免支撑
// =============================================================================

/* [挂销尺寸 —— 参考件实测值] */
peg_d      = 5.50;   // 销身直径 (实测等径 Ø5.50)
rib_d      = 5.97;   // 卡环峰直径 (实测 Ø5.97 ≈ 孔径, 零过盈)
rib_pos    = 3.95;   // 卡环峰到板面距离 (实测)
peg_len    = 8.01;   // 轴总长 (含球头, 实测)
ball_trim  = 1.49;   // 球头末端直径 (实测收口, 不封死成尖)

/* [孔板] */
hole_d     = 6.00;   // 目标孔径 (仅打印在文件里作对照标注)
// FDM 提示: 打出来孔常偏小 0.1~0.2。首件建议先把 rib_d 加到 6.20 试装;
//           太松往回收 0.1, 太紧往外放 0.1, 可用区间 6.0 ~ 6.4。

/* [排布] */
mode       = "single";  // [single: 单件, row: 一排多件]
count      = 5;         // row 模式的件数
gap        = 4.0;       // row 模式的件间距 (mm, 便于刀切分离)

/* [精度] */
$fn        = 96;

// ---------------------------------------------------------------- 单销
module peg() {
    R  = peg_d / 2;
    Rr = rib_d / 2;
    h_body = peg_len - R;                                   // 圆柱段 (球心落在轴端)
    // 球头在 ball_trim 直径处的截平面高度 → 端面留一个小平顶
    cut_z  = h_body + sqrt(max(R * R - pow(ball_trim / 2, 2), 0.0001));

    difference() {
        union() {
            cylinder(h = h_body, r = R);
            // 球头: 与销身相切
            translate([0, 0, h_body]) sphere(r = R);
            // 卡环: 环形凸筋, 截面圆 Ø1.10, 外缘正好到 rib_d/2
            translate([0, 0, rib_pos])
                rotate_extrude($fn = 64)
                    translate([Rr - 0.55, 0]) circle(r = 0.55, $fn = 28);
        }
        // 端面削平到 ball_trim
        translate([0, 0, cut_z]) cylinder(h = 6, r = Rr + 2, $fn = 64);
    }
}

// ---------------------------------------------------------------- 输出
if (mode == "row") {
    for (i = [0 : count - 1])
        translate([i * (peg_d + gap), 0, 0]) peg();
} else {
    peg();
}

// ---------------------------------------------------------------- 自检
echo(str("销身 Ø", peg_d, " · 卡环 Ø", rib_d, " @ ", rib_pos,
         " · 轴长 ", peg_len, " · 卡环高出销身 ",
         (rib_d - peg_d) / 2, " mm (单边)"));
echo(str("孔板孔径 ", hole_d, " → 过盈量 ", rib_d - hole_d, " mm (负值=松)"));
